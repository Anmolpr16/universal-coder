# Server authentication
CODER_AUTH_TOKEN=replace-with-a-long-random-token

# Provider
CODER_PROVIDER=openai-compatible
CODER_MODEL=llama3.1
CODER_BASE_URL=http://127.0.0.1:11434/v1
# CODER_API_KEY=

# Execution
CODER_SANDBOX_MODE=isolated
CODER_SANDBOX_IMAGE=python:3.13-slim
CODER_MAX_STEPS=40
CODER_COMMAND_TIMEOUT=120
CODER_MAX_OUTPUT=12000
CODER_MAX_CONCURRENT_RUNS=2
CODER_MAX_REQUEST_BYTES=1000000

# Server access control
CODER_WORKSPACE_ROOTS=/workspace
CODER_REQUIRE_AUTH=1
# For remote TLS deployment:
# CODER_TLS_CERT=/run/secrets/server.crt
# CODER_TLS_KEY=/run/secrets/server.key
